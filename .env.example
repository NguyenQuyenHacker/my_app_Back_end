# Database chính (FastAPI app — banking_db)
DATABASE_URL=postgresql://fastapi_user:123456@localhost:5432/banking_db

# Database admin (pgvector cho RAG)
DATABASE_URL_ADMIN=postgresql+psycopg://fastapi_user:123456@localhost:5434/banking_db

# SQL echo (true cho dev, false cho prod)
DB_ECHO=false

# Google Gemini API key (lấy ở https://aistudio.google.com/apikey)
GOOGLE_API_KEY=CHANGE_ME

# JWT secret key (random string, ví dụ: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME
