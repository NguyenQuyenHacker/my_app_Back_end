# LangSmith tracing (optional — bỏ trống nếu không dùng)
LANGSMITH_API_KEY=CHANGE_ME
LANGSMITH_TRACING=true

# Google Gemini (bắt buộc — config.py sẽ raise nếu thiếu)
GOOGLE_API_KEY=CHANGE_ME

# Vector database cho RAG (bắt buộc)
# Trong container LangGraph: dùng host.docker.internal để gọi pgvector trên host
VECTOR_DB_URL=postgresql+psycopg://fastapi_user:CHANGE_ME@host.docker.internal:5434/banking_db
VECTOR_TABLE_NAME=document_chunks
VECTOR_SCHEMA_NAME=public

# Backend FastAPI URL (agent gọi ngược về backend qua HTTP)
API_BASE_URL=http://host.docker.internal:8000
