# Google Gemini (bắt buộc — config.py sẽ raise nếu thiếu)
GOOGLE_API_KEY=CHANGE_ME

# Vector database cho RAG (bắt buộc) — driver SYNC psycopg
VECTOR_DB_URL=postgresql+psycopg://fastapi_user:CHANGE_ME@localhost:5434/banking_db
VECTOR_TABLE_NAME=document_chunks
VECTOR_SCHEMA_NAME=public

# Database lưu lịch sử hội thoại (bắt buộc) — driver ASYNC asyncpg
# Bảng agent_sessions / agent_messages do Agents SDK tự tạo.
SESSION_DATABASE_URL=postgresql+asyncpg://fastapi_user:CHANGE_ME@localhost:5432/agent_session

# Backend FastAPI URL (agent gọi ngược về backend qua HTTP)
# Chạy trực tiếp trên máy: localhost. Chạy trong container: host.docker.internal
API_BASE_URL=http://localhost:8000

# Origin frontend được phép gọi serving, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173
